//============================================
// Spawning
//============================================
class WildGSP : IdleDummy {
	override void postbeginplay() {
		super.postbeginplay();
		let SpawnedGSP=GunsmithPouch(spawn("GunsmithPouch",pos,ALLOW_REPLACE));
		SpawnedGSP.vel = vel;
		SpawnedGSP.RandomContents();
		self.destroy();
	}
}
