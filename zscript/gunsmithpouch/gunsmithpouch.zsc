	States {
		Spawn:
			GSPP ABC -1 NoDelay {
				if (invoker.items.size() == 0) {
					frame = 1;
				} else if (target) {
					translation = target.translation;
					frame = 2;
				}

				invoker.bNO_AUTO_SWITCH = false;
			}
			Stop;
	}
}

class GSPStorageItemList : HDStorageItemList {
	override bool CanAdd(Class<Inventory> itemCls) {
		return HDCore.isChildClass(itemCls, 'HDRel_CraftingMaterial');
	}
}

class WildGSP : IdleDummy {
	override void postBeginPlay() {
		super.postBeginPlay();

		let gsp = GunsmithPouch(spawn("GunsmithPouch", pos, ALLOW_REPLACE));
		gsp.RandomContents("GSPStorageItemList", frandom(0.1, 0.5), false);

		HDF.TransferSpecials(self, gsp);
		
		destroy();
	}
}
