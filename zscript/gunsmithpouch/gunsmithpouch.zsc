const HDLD_GSPOUCH = "gsp";

enum GSPouchSlots {

	// From HDStorageItemStats
	// ------------------------

	// SISTAT_ININDEX  = 1,
	// SISTAT_SELINDEX = 2,
	// SISTAT_HOWMANY  = 3,
	// SISTAT_SCROLL   = 4,

	// SI_WEPICONSLOT  = HDWEP_STATUSSLOTS + 1,
	// SI_WEPBULKSLOT  = HDWEP_STATUSSLOTS + 2,
	// SI_MAXROWS      = 10,
	// SI_MAXBUNCH     = 20,
	// SI_SCROLLCYCLE  = (2 << 9),

	GSP_AMOUNT         = 5
}

//==================================================
// Base Definition
//==================================================
class GunsmithPouch : HDStorageItem {

	default {
		+Inventory.INVBAR
		+Weapon.WIMPY_WEAPON
		// -HDWeapon.DROPTRANSLATION
		+HDWeapon.FITSINBACKPACK
		// +HDWeapon.IGNORELOADOUTAMOUNT

		Tag "$TAG_GUNSMITH_POUCH";
		Inventory.Icon "GSPPA0";
		Inventory.PickupMessage "$PICKUP_GUNSMITH_POUCH";
		Inventory.PickupSound "weapons/pocket";
		scale 0.6;

		hdweapon.wornlayer 0;
		hdweapon.refid HDLD_GSPOUCH;

		HDStorageItem.minBulk 35;
		HDStorageItem.maxCapacity 50;
		HDStorageItem.maxBunch 200;
	}

	override bool IsBeingWorn() { return false; }

	override double WeaponBulk() {
		return ContainerBulk(itemBulk);
	}

	override double ContainerBulk(double it) const {
		let numPouches = max(weaponStatus[GSP_AMOUNT], 1);
		let calcAmount = min(numPouches, 5);
		let reductionFactor = 0.45 + min(0.05 * calcAmount, 0.5);

		return max(it * reductionFactor, minBulk * numPouches);
	}

	override void BeginPlay() {
		super.BeginPlay();

		weaponStatus[GSP_AMOUNT] = max(weaponStatus[GSP_AMOUNT], 1);
	}

	override void PostBeginPlay() {
		super.PostBeginPlay();

		weaponStatus[GSP_AMOUNT] = max(weaponStatus[GSP_AMOUNT], 1);
	}

	override bool CanFitInThisContainer(Class<Inventory> itemType) {
		return HDCore.isChildClass(itemType, 'HDRel_CraftingMaterial');
	}

	override bool ThisCanFitInThisContainer(Inventory item) {
		return HDCore.isChildClass(item.getClass(), 'HDRel_CraftingMaterial');
	}

	override void actualpickup(actor other, bool silent) {
		let gsp = GunsmithPouch(other.findinventory("GunsmithPouch"));
		if (gsp) {
			gsp.weaponStatus[GSP_AMOUNT]++;
			gsp.maxCapacity = gsp.weaponStatus[GSP_AMOUNT] * gsp.default.maxCapacity;

			while (items.size()) {

				string itemCls, prefix;
				[itemCls, prefix] = itemClassAndPrefix(0);

				let amt = count(itemCls);
				gsp.insert(extract(0, amt), amt);
			}

			destroy();
			return;
		}

		super.actualpickup(other, silent);
	}

	override inventory CreateTossable(int amt) {
		amount = weaponStatus[GSP_AMOUNT]; // Hack to satisfy CreateTossable expectations

		let gsp = GunsmithPouch(super.CreateTossable(amt));

		if (gsp && weaponStatus[GSP_AMOUNT] > 1) {
			let bulkRatio = itemBulk / (maxCapacity * 1.0);
			weaponStatus[GSP_AMOUNT]--;
			maxCapacity = weaponStatus[GSP_AMOUNT] * default.maxCapacity;

			if (items.size() <= 0) return gsp;

			while (gsp.itemBulk / gsp.maxCapacity < bulkRatio) {

				string itemCls, prefix;
				[itemCls, prefix] = itemClassAndPrefix(0);
	
				if (itemCls) {

					double unitBulk = max(getDefaultByType((Class<HDPickup>)(itemCls)).bulk * HDMath.getEncumbranceMult(), Double.EPSILON);
		
					int amt = min((gsp.maxCapacity - gsp.itemBulk) / unitBulk, count(itemCls));
					gsp.insert(extract(0, amt), amt);
				}
			}
		}

		return gsp;
	}

	// Configure from Loadout
	override void LoadoutConfigure(string input) {
		super.LoadoutConfigure(input);

		int amt = input.ToInt();
		if (amt > 0) weaponStatus[GSP_AMOUNT] = amt;
	}

