		let bofs = -120;
		int lnh = SmallFont.GetHeight() + 3;

	// 	sb.DrawString(sb.pSmallFont, "\c[DarkBrown][] [] [] \c[DarkGreen]"..StringTable.localize("$TAG_GUNSMITH_POUCH").."\c[DarkBrown] [] [] []", (0, BaseOffset), sb.DI_SCREEN_CENTER | sb.DI_TEXT_ALIGN_CENTER);
		if (weaponStatus[GSP_AMOUNT] > 1) sb.DrawString(sb.pSmallFont, "Pouches: \cf"..weaponStatus[GSP_AMOUNT].."\c-", (0, bofs + (lnh * 2)), sb.DI_SCREEN_CENTER|sb.DI_TEXT_ALIGN_CENTER);

